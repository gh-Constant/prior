# Copy to scripts/macos/signing.env (git-ignored) to notarize local builds.
# Apple ID flow: an app-specific password from https://account.apple.com/account/manage
APPLE_ID=you@example.com
APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional: defaults to the team id in the Developer ID certificate name
#APPLE_TEAM_ID=XPB668GFX4

# Alternative: App Store Connect API key (leave the Apple ID variables empty)
#APPLE_API_KEY=ABC123DEFG
#APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
#APPLE_API_KEY_PATH=/path/to/AuthKey_ABC123DEFG.p8

# Optional: Tauri updater key so the local build also emits signed updater artifacts
#TAURI_SIGNING_PRIVATE_KEY=
#TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
