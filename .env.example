# Prior API
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://prior:prior@localhost:5432/prior?sslmode=disable
PUBLIC_API_URL=https://api.prior.constantsuchet.fr
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.prior.constantsuchet.fr/auth/google/callback
# Calendar OAuth derives its callback from the line above:
# https://api.prior.constantsuchet.fr/v1/calendar/google/callback
ALLOWED_AUTH_RETURN_ORIGINS=prior://auth/callback,http://localhost:1420/auth/callback,http://127.0.0.1:1420/auth/callback,https://app.prior.constantsuchet.fr/auth/callback
# Extra accepted `aud` values for native Android sign-in ID tokens
# (Android OAuth client IDs from Google Cloud Console). Empty = GOOGLE_CLIENT_ID.
GOOGLE_NATIVE_AUDIENCES=
# Installed Android apps older than this version must update (blocking screen).
# Leave empty to never force an update.
MIN_ANDROID_VERSION=
# Server-issued session lifetime. Native apps hold their token in the OS
# keychain, so a long TTL is acceptable there. Browser sessions live in
# localStorage (see specs/AUTH.md) and are more exposed: prefer a short TTL
# such as 168h (7 days) when the API primarily serves the web client.
SESSION_TTL=720h
# Optional 32-byte hex key to seal per-user assistant secrets (OpenRouter and
# OpenAI API keys) at rest with AES-256-GCM. Generate with: openssl rand -hex 32
# Empty = stored without at-rest sealing (access stays owner-only).
SETTINGS_ENCRYPTION_KEY=

# Prior AI: the hosted assistant every signed-in user gets without a key.
# Leave AI_API_KEY empty to disable it (users then need their own keys).
# Any OpenAI-compatible endpoint works; OpenRouter is the default router.
# Model IDs are per use case so they can change without a release.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_AGENT=z-ai/glm-5.3-flash
AI_MODEL_RECOMMENDATIONS=openai/gpt-6-luna
AI_MODEL_MAIL=openai/gpt-6-luna
AI_MODEL_CALENDAR=openai/gpt-6-luna
# Comma-separated models OpenRouter tries when the primary one fails.
AI_MODEL_FALLBACKS=deepseek/deepseek-v4.1-flash
# OpenRouter reasoning.effort (none|minimal|low|medium|high); empty = default.
AI_REASONING_EFFORT_AGENT=
AI_REASONING_EFFORT_DRAFTS=low
# Who may use Prior AI before paid plans exist (comma-separated emails).
# Everyone else needs a paid plan, or their own OpenRouter key or Codex.
AI_HOSTED_ALLOWED_EMAILS=
# Abuse backstop: hosted requests (chat + dictation) per user per UTC day.
AI_DAILY_REQUESTS_PER_USER=300
# Dictation. The key defaults to AI_API_KEY and the URL to
# AI_BASE_URL/audio/transcriptions (OpenAI-compatible).
AI_TRANSCRIPTION_API_KEY=
AI_TRANSCRIPTION_URL=
AI_TRANSCRIPTION_MODEL=microsoft/mai-transcribe-2

# Billing (Stripe). Keys come from Coolify env vars only, never the repo.
# On start the API creates its own products, prices, customer-portal settings
# and, when PUBLIC_API_URL is public https and STRIPE_WEBHOOK_SECRET is empty,
# its own webhook endpoint. Test keys (sk_test_) and live keys (sk_live_)
# each get their own catalog.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional: only if you create the webhook endpoint by hand in Stripe.
STRIPE_WEBHOOK_SECRET=
# Where Checkout and the portal return when the client gives no allowed URL.
BILLING_RETURN_URL=https://app.prior.constantsuchet.fr/
# Verified accounts that can open the admin dashboard (comma-separated).
ADMIN_EMAILS=constantsuchet@gmail.com

# Account emails (password reset, email verification) through Resend.
# Empty RESEND_API_KEY: development logs the link to stdout, production sends
# nothing. The EMAIL_FROM domain must be verified in Resend (SPF/DKIM DNS).
RESEND_API_KEY=
EMAIL_FROM=Prior <no-reply@prior.constantsuchet.fr>
# Web app origin used in emailed links (/reset-password, /verify-email).
WEB_APP_URL=https://app.prior.constantsuchet.fr
# 32-byte hex key sealing TOTP 2FA secrets (AES-256-GCM). Required to turn
# 2FA on; never change it once users enabled 2FA. openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Browser client / Tauri development
VITE_API_URL=http://localhost:8080
