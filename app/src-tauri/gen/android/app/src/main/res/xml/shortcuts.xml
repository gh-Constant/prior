<?xml version="1.0" encoding="utf-8"?>
<!-- PRIOR (not generated): long-press the launcher icon → New task. Keep when
     regenerating the Android project. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_task"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_new_task_short"
        android:shortcutLongLabel="@string/shortcut_new_task_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="prior://new-task"
            android:targetPackage="fr.constantsuchet.prior"
            android:targetClass="fr.constantsuchet.prior.MainActivity" />
    </shortcut>
</shortcuts>
