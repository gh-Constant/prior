{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Prior's intentionally small capability set",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*", "app": "inAppBrowser" },
        { "url": "http://*", "app": "inAppBrowser" }
      ]
    },
    "deep-link:default",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/Library/Group Containers/group.fr.constantsuchet.prior/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$HOME/Library/Group Containers/group.fr.constantsuchet.prior/**" }]
    },
    "process:default",
    "sql:default",
    "sql:allow-execute",
    "updater:default",
    "websocket:default"
  ]
}
