{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prior",
  "version": "0.3.3",
  "identifier": "fr.constantsuchet.prior",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Prior",
        "width": 1180,
        "height": 760,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8080 https://api.prior.constantsuchet.fr wss://api.prior.constantsuchet.fr https://api.github.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["prior"] },
      "mobile": [
        {
          "host": "app.prior.constantsuchet.fr",
          "pathPrefix": ["/auth/callback"],
          "appLink": true
        }
      ]
    },
    "sql": { "preload": ["sqlite:prior.db"] },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCOTYyRkNGQjZFOEMzNUUKUldSZXcraTJ6eStXaXdoaHA1K1VEdThqditBOE1lR2lWR1c1VHFzTFRPblJJUG91eWwxbkgvSXkK",
      "endpoints": ["https://github.com/gh-Constant/prior/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    },
    "opener": { "requireLiteralLeadingDot": true }
  }
}
